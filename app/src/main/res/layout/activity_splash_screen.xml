<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F2851"
    android:gravity="center">

    <ImageView
        android:id="@+id/imgSplashLogo"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_centerInParent="true"
        android:src="@android:drawable/ic_lock_lock" />

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/imgSplashLogo"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:text="SELLORA"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvAppTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:text="Smart Sales Management"
        android:textColor="#00A896"
        android:textSize="14sp" />

</RelativeLayout>