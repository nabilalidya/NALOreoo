<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Theme -->
    <style name="Theme.NALOreo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Brand Colors (Figma Navy & Teal) -->
        <item name="colorPrimary">#0F2851</item>
        <item name="colorPrimaryVariant">#0F2851</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#00A896</item>
        <item name="colorSecondaryVariant">#00A896</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Status Bar & Background -->
        <item name="android:statusBarColor">#0F2851</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#F8FAFC</item>
    </style>

    <!-- Custom Style untuk Tombol & Input Membulat (Pastel Rounded) -->
    <style name="PastelButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PastelInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">#0F2851</item>
        <item name="hintTextColor">#0F2851</item>
    </style>
</resources>