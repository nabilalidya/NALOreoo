<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- IZIN INTERNET UNTUK WEBVIEW INFO SELLORA -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="SELLORA"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NALOreo">

        <!-- 1. SplashScreenActivity Sebagai LAUNCHER UTAMA -->
        <activity
            android:name=".project_sellora.SplashScreenActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. WelcomeActivity -->
        <activity
            android:name=".project_sellora.WelcomeActivity"
            android:exported="false" />

        <!-- 3. AuthActivity (Login) -->
        <activity
            android:name=".project_sellora.AuthActivity"
            android:exported="false" />

        <!-- 4. BerandaActivity -->
        <activity
            android:name=".project_sellora.BerandaActivity"
            android:exported="false" />

        <!-- 5. ProfileDeveloperActivity -->
        <activity
            android:name=".project_sellora.ProfileDeveloperActivity"
            android:exported="false" />

        <!-- 6. WebActivity (Info Sellora) -->
        <activity
            android:name=".WebActivity"
            android:exported="false" />

        <!-- 7. RegisterActivity (Soal 1) -->
        <activity
            android:name=".project_sellora.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 8. VerificationActivity (Soal 2) -->
        <activity
            android:name=".project_sellora.VerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>